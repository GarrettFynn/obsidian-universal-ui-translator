{
  "name": "obsidian-universal-ui-translator",
  "version": "1.1.8",
  "description": "Translate Obsidian core and community plugin UI with your own translation API.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "i18n",
    "translation"
  ],
  "author": "GarrettFynn",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "jsdom": "^24.0.0",
    "@vitest/coverage-v8": "^1.5.0"
  }
}
